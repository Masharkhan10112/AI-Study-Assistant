# Client-side configuration. `npx supabase status` prints both values for the
# local stack; a hosted project shows them under Project Settings → API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Server-side only. Never expose these to the browser: they are set as Edge
# Function secrets (`supabase secrets set ...`), not read from this file at runtime.
# SUPABASE_SERVICE_ROLE_KEY=
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small

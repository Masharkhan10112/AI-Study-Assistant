{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.116.0",
    "zod": "npm:zod@3.25.76",
    "unpdf": "npm:unpdf@1.8.1",
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "tasks": {
    "test": "deno test --allow-env --no-check=remote",
    "check": "deno check **/*.ts",
    "fmt": "deno fmt --check",
    "lint": "deno lint"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["**/*.md"]
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  }
}
